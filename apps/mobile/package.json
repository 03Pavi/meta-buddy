{
  "name": "PaviAssistant",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "android:devices": "node scripts/adb.js devices",
    "android:release": "cd android && .\\gradlew.bat assembleRelease",
    "android:install": "node scripts/adb.js install -r android/app/build/outputs/apk/release/app-release.apk",
    "model:push": "node scripts/push-model.js",
    "web:build": "expo export --platform web --output-dir dist",
    "web:serve": "node scripts/serve-web.js"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-voice/voice": "^3.2.4",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "^58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-font": "^58.0.11",
    "llama.rn": "^0.12.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "^4.30.1",
    "react-native-tts": "^4.1.1",
    "react-native-vosk": "^2.1.7",
    "react-native-web": "^0.21.4",
    "react-native-zip-archive": "^9.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "main": "index.js"
}
